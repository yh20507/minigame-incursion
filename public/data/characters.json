  { "id": "seraphina", "name": "세라피나", "title": "기사단장", "domain": "ashen", "rarity": 4, "pool": true, "passives": [{ "type": "score", "value": 15 }, { "type": "shield", "value": 1 }], "desc": "왕국 최후의 기사단을 이끄는 단장. 왕을 구하기 위해 검을 놓지 않았다.", "line": "잿빛 왕관의 이름으로, 길을 열겠다." },
  { "id": "cassian", "name": "카시안", "title": "잿빛 용 기수", "domain": "ashen", "rarity": 4, "pool": true, "passives": [{ "type": "coin", "value": 20 }, { "type": "time", "value": 3 }], "desc": "마지막 남은 잿빛 용과 함께 하늘을 나는 기수. 자유를 무엇보다 사랑한다.", "line": "꽉 잡아. 하늘로 간다!" },
