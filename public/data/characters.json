  { "id": "marcus", "name": "마르쿠스", "title": "연금술사", "domain": "ashen", "rarity": 2, "pool": true, "passives": [{ "type": "coin", "value": 8 }], "desc": "잿더미에서 금을 만들겠다는 꿈을 버리지 못한 연금술사.", "line": "실험은 실패해도 기록은 남지." },
