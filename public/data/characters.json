  { "id": "garret", "name": "가렛", "title": "용병단장", "domain": "ashen", "rarity": 3, "pool": true, "passives": [{ "type": "score", "value": 12 }], "desc": "돈만 주면 뭐든 한다고 큰소리치지만, 의리 때문에 손해를 더 많이 본다.", "line": "계약 성립이다. 뒤는 맡겨." },
