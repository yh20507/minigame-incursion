[
  { "id": "teumsae", "name": "틈새", "title": "균열의 정령", "domain": "rift", "rarity": 1, "pool": false, "passives": [{ "type": "coin", "value": 5 }], "desc": "균열에서 태어난 작은 정령. 수다스럽고 호기심이 많다. 방랑자의 첫 동료.", "line": "같이 가자, 방랑자!" },

